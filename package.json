{
  "name": "farming-nyumbani",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Farming Nyumbani - a farm leasing marketplace for Kenya",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build && node scripts/spa-fallback.mjs",
